# PostgreSQL connection string used by SQLAlchemy / Alembic
DATABASE_URL=postgresql+psycopg2://decisionos:decisionos@localhost:5432/decisionos

# App
APP_ENV=development
LOG_LEVEL=INFO

# Meta (WhatsApp) Cloud API
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=change-me
WHATSAPP_PHONE_NUMBER_ID=change-me
# Used to verify the X-Hub-Signature-256 header on every inbound webhook
# POST (app/channels/whatsapp.py) — set this to the app secret shown in
# Meta App Dashboard > Settings > Basic, not a value you invent yourself.
WHATSAPP_APP_SECRET=change-me

# Gmail API (OAuth2 client, service account, or refresh-token flow)
GMAIL_CLIENT_ID=change-me
GMAIL_CLIENT_SECRET=change-me
GMAIL_REFRESH_TOKEN=change-me
GMAIL_SENDER_ADDRESS=negotiator@example.com

# Anthropic (subagent LLM calls — see app/llm.py)
ANTHROPIC_API_KEY=change-me
# Per-subagent model override. app/prompts/README.md's suggestion: Sonnet for
# Stratejist/Yazıcı, Haiku for Analist/Kritik — confirm against llm_calls cost data.
MODEL_YAZICI=claude-sonnet-4-6
MODEL_STRATEJIST=claude-sonnet-4-6
MODEL_ANALIST=claude-haiku-4-5-20251001
MODEL_KRITIK=claude-haiku-4-5-20251001
MODEL_INTAKE=claude-sonnet-4-6

# Bearer token required on every /review/* request (app/review.py), and the
# HTTP Basic password for the operator panel at /admin (app/admin/).
# Generate a real random value before deploying — anyone who has this
# token can approve/send messages as the agent. e.g.: openssl rand -hex 32
REVIEW_TOKEN=change-me
